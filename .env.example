# Salin file ini menjadi ".env" lalu isi dengan kredensial project Supabase Anda.
# Sumber: Supabase Dashboard -> Project Settings -> API
# Jangan pernah memakai service_role key di aplikasi klien.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-key-dari-dashboard-supabase

# Opsional: hanya diubah bila aplikasi di-deploy pada subpath.
# VITE_BASE_PATH=/
